# Copy to api/.env and fill in. Never commit api/.env.

# Gnani
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_MODEL=prisma-v3.0
GNANI_LANG_HINGLISH=hi-IN,en-IN
GNANI_LANG_MARATHI=mr-IN,en-IN
GNANI_FORMAT=transcribe
GNANI_WITH_DENOISE=false
GNANI_POLL_SECONDS=10
GNANI_MAX_CONCURRENT=1

# LLM
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_RPM_LIMIT=30
LLM_TPM_LIMIT=8000
LLM_CACHE=on

# Storage and database
STORAGE_BACKEND=local            # local (Phase 2) | supabase (Phase 3+)
DATABASE_URL=sqlite:///./local.db   # Supabase: the Session pooler string from Connect (see supabase/README.md)
LOCAL_AUDIO_DIR=./.data/audio
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=call-audio

# Limits and safety
MAX_UPLOAD_MB=25
MAX_CALL_MINUTES=8
DEMO_MODE=false
UPLOAD_PASSCODE=
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:3000
WORKER_ENABLED=true
